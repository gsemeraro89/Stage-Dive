# Copy this file to .env and fill in the values. Never commit .env.

# PostgreSQL connection string.
# Local: postgresql://postgres@127.0.0.1:5432/opendecks
# Render: set automatically from the Render database (Internal Database URL).
DATABASE_URL=

# Optional: a separate, disposable database for the automated tests (npm test).
# Tests that need a database are skipped when this is empty. It is wiped on every run.
TEST_DATABASE_URL=

# Public address of the site, used for canonical links (no trailing slash).
# On Render this is filled in automatically; set it only for a custom domain.
SITE_URL=

# Which sets this copy of the site shows: SEED (hand-picked), COLLECTOR (found automatically), MANUAL.
# Comma-separated; empty = all. The live site is set to SEED until the owner opens the catalogue;
# the demo site leaves it empty and shows everything.
SITE_SOURCES=

# Admin pages (/admin). Any user name, this password. Leave empty to switch the admin pages off.
# On Render: set it in the web service's Environment.
ADMIN_PASSWORD=

# Collector and refresh jobs (run on GitHub Actions; set these as repository secrets there).
# Locally they are only needed to run `npm run collect` / `npm run refresh` by hand.
YOUTUBE_API_KEY=
ANTHROPIC_API_KEY=

# Collector settings (optional; defaults shown). On GitHub: repository variables.
# VIEW_THRESHOLD=10000000
# MAX_CLASSIFY_PER_RUN=200
# YOUTUBE_UNIT_BUDGET=8000
# MIN_CONFIDENCE=0.75
# DECISION_TTL_DAYS=30
# BATCH_WAIT_MINUTES=45   (how long a run waits for half-price Batch API answers; the rest is picked up next run)

# Per-artist lane (npm run artist-lane; collect.yml inputs artist_search / haiku_test). Defaults shown.
# CLAUDE_BUDGET_USD=3        (most Claude may cost in one run; the rest waits for the next run)
# LANE_CLASSIFIER=haiku      (owner default; auto follows the last Haiku test; haiku+opus asks Opus when Haiku is unsure)
# LANE_SOURCES=              (empty = long,channel,search,handles; a cheap pass: answers,matches)
# LANE_SEARCHES=             (most YouTube searches this run; empty = as many as the unit budget allows)
# LANE_CHANNEL_CAP=150       (newest uploads read from each artist's own channel)
# LANE_WAIT_MINUTES=40       (how long to wait for the half-price classification batch)
# LANE_WRITEUP_WAIT_MINUTES=30 (how long to wait for the write-up batch)

# How long lists, counts and menus are kept in memory before being read again (seconds). 0 = off.
# PAGE_CACHE_SECONDS=300
